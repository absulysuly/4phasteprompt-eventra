{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Iraq Discovery Dataset Schema",
  "version": "1.0.0",
  "description": "Normalized schema for all place/event/service records in Iraq Discovery. All records share universal fields; each category has specific extensions.",
  
  "definitions": {
    "UniversalRecord": {
      "type": "object",
      "required": ["id", "name", "canonical_category", "address", "latitude", "longitude", "source_url", "last_updated"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique internal identifier (UUID or namespaced ID)"
        },
        "name": {
          "type": "string",
          "description": "Display name of the place/event/service/company"
        },
        "canonical_category": {
          "type": "string",
          "enum": [
            "Accommodation",
            "Cafe & Restaurants",
            "Events",
            "Tourism",
            "Government Offices",
            "Services",
            "Companies",
            "Shopping"
          ]
        },
        "subcategory": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Category-specific tags/subtypes"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional keywords for search and filtering"
        },
        "address": {
          "type": "object",
          "required": ["street", "city", "governorate"],
          "properties": {
            "street": { "type": "string" },
            "neighborhood": { "type": "string" },
            "city": { "type": "string" },
            "governorate": { "type": "string" },
            "postal_code": { "type": "string" }
          }
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "geocode_source": {
          "type": "string",
          "description": "Source used for geocoding (e.g., Google, OpenStreetMap)"
        },
        "phone": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "email": { "type": "string", "format": "email" },
        "opening_hours": {
          "type": "object",
          "description": "Structured opening hours by day of week",
          "patternProperties": {
            "^(monday|tuesday|wednesday|thursday|friday|saturday|sunday)$": {
              "type": "object",
              "properties": {
                "open": { "type": "string", "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$" },
                "close": { "type": "string", "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$" },
                "closed": { "type": "boolean" }
              }
            }
          }
        },
        "price_range": {
          "type": "string",
          "enum": ["low", "medium", "high", "very_high"],
          "description": "Standardized price level"
        },
        "price_numeric": {
          "type": "object",
          "description": "Optional numeric price bounds in IQD",
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "currency": { "type": "string", "default": "IQD" }
          }
        },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "Average rating (0-5 scale)"
        },
        "rating_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of ratings/reviews"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "caption": { "type": "string" },
              "thumbnail_url": { "type": "string", "format": "uri" }
            }
          }
        },
        "languages_supported": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Languages spoken or supported (e.g., Arabic, Kurdish, English)"
        },
        "accessibility": {
          "type": "object",
          "properties": {
            "wheelchair_accessible": { "type": "boolean" },
            "family_friendly": { "type": "boolean" },
            "parking_available": { "type": "boolean" }
          }
        },
        "description": {
          "type": "string",
          "description": "Short description (1-2 sentences)"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "Original source URL where data was collected"
        },
        "source_license": {
          "type": "string",
          "description": "License or rights statement (e.g., CC-BY, proprietary, public)"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last data update"
        }
      }
    },
    
    "Accommodation": {
      "allOf": [
        { "$ref": "#/definitions/UniversalRecord" },
        {
          "properties": {
            "star_rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "amenities": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["wifi", "pool", "parking", "gym", "ac", "breakfast", "laundry", "concierge", "restaurant", "bar"]
              }
            },
            "room_types": {
              "type": "array",
              "items": { "type": "string" }
            },
            "checkin_time": { "type": "string", "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$" },
            "checkout_time": { "type": "string", "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$" }
          }
        }
      ]
    },
    
    "CafeRestaurant": {
      "allOf": [
        { "$ref": "#/definitions/UniversalRecord" },
        {
          "properties": {
            "cuisine_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["Arabic", "Iraqi", "Kurdish", "Mediterranean", "Turkish", "International", "Vegetarian", "Vegan", "Fast Food", "Seafood"]
              }
            },
            "delivery": { "type": "boolean" },
            "accepts_reservations": { "type": "boolean" },
            "outdoor_seating": { "type": "boolean" },
            "halal": { "type": "boolean" },
            "dietary_options": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    
    "Event": {
      "allOf": [
        { "$ref": "#/definitions/UniversalRecord" },
        {
          "required": ["start_datetime", "end_datetime", "venue_name"],
          "properties": {
            "event_type": {
              "type": "string",
              "enum": ["Concert", "Festival", "Exhibition", "Workshop", "Sports", "Market", "Theater", "Conference", "Other"]
            },
            "start_datetime": {
              "type": "string",
              "format": "date-time"
            },
            "end_datetime": {
              "type": "string",
              "format": "date-time"
            },
            "venue_name": { "type": "string" },
            "organizer": { "type": "string" },
            "ticket_url": { "type": "string", "format": "uri" },
            "is_free": { "type": "boolean" }
          }
        }
      ]
    },
    
    "Tourism": {
      "allOf": [
        { "$ref": "#/definitions/UniversalRecord" },
        {
          "properties": {
            "attraction_type": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["Landmark", "Picnic Area", "Cultural Site", "Must See", "Hidden Gem", "Natural Area", "Museum", "Park"]
              }
            },
            "entry_fee": {
              "type": "string",
              "enum": ["free", "paid"]
            },
            "best_visit_time": { "type": "string" },
            "guided_tours_available": { "type": "boolean" }
          }
        }
      ]
    },
    
    "GovernmentOffice": {
      "allOf": [
        { "$ref": "#/definitions/UniversalRecord" },
        {
          "properties": {
            "office_type": {
              "type": "string",
              "enum": ["Passport Office", "Municipality", "Ministry", "Court", "Social Services", "Police Station", "Municipal Services"]
            },
            "services_offered": {
              "type": "array",
              "items": { "type": "string" }
            },
            "required_documents": {
              "type": "array",
              "items": { "type": "string" }
            },
            "appointment_required": { "type": "boolean" },
            "working_hours_notes": { "type": "string" }
          }
        }
      ]
    },
    
    "Service": {
      "allOf": [
        { "$ref": "#/definitions/UniversalRecord" },
        {
          "properties": {
            "primary_service_type": {
              "type": "string",
              "enum": ["Health Services", "Professional Services", "Education", "Banking", "Telecom", "Repair Services", "Financial Services", "Legal Services"]
            },
            "service_subcategory": { "type": "string" },
            "accepts_online_booking": { "type": "boolean" },
            "emergency_service": { "type": "boolean" }
          }
        }
      ]
    },
    
    "Company": {
      "allOf": [
        { "$ref": "#/definitions/UniversalRecord" },
        {
          "properties": {
            "industry": {
              "type": "string",
              "enum": ["Architecture", "Tourism", "Trading", "Technology", "Manufacturing", "Consulting", "Retail", "Oil & Gas", "Construction", "Finance"]
            },
            "company_size": {
              "type": "string",
              "enum": ["startup", "SME", "enterprise"]
            },
            "services_products": {
              "type": "array",
              "items": { "type": "string" }
            },
            "is_hiring": { "type": "boolean" },
            "verified": { "type": "boolean" }
          }
        }
      ]
    },
    
    "Shopping": {
      "allOf": [
        { "$ref": "#/definitions/UniversalRecord" },
        {
          "properties": {
            "store_type": {
              "type": "string",
              "enum": ["Shopping Mall", "Retail Store", "Bazaar", "Boutique", "Supermarket"]
            },
            "main_products": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["Clothing", "Electronics", "Food", "Books", "Souvenirs", "Home Goods", "Jewelry", "Cosmetics"]
              }
            },
            "accepts_credit_cards": { "type": "boolean" }
          }
        }
      ]
    }
  },
  
  "oneOf": [
    { "$ref": "#/definitions/Accommodation" },
    { "$ref": "#/definitions/CafeRestaurant" },
    { "$ref": "#/definitions/Event" },
    { "$ref": "#/definitions/Tourism" },
    { "$ref": "#/definitions/GovernmentOffice" },
    { "$ref": "#/definitions/Service" },
    { "$ref": "#/definitions/Company" },
    { "$ref": "#/definitions/Shopping" }
  ]
}
