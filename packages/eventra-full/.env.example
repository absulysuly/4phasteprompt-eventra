DATABASE_URL=<REPLACE_ME>
NEXTAUTH_URL=<REPLACE_ME>
NEXTAUTH_SECRET=<REPLACE_ME>

# Google OAuth - Replace with actual values to enable Google sign-in
GOOGLE_CLIENT_ID=<REPLACE_ME>
GOOGLE_CLIENT_SECRET=<REPLACE_ME>

# Client-side feature flags (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SHOW_TOP_BANNER=false
NEXT_PUBLIC_ENABLE_GOOGLE=false
