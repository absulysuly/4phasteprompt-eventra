{
  "name": "eventra-full-service",
  "version": "0.1.0",
  "private": true,
  "description": "Full-service event platform with hotels, restaurants, and travel bookings - built with Next.js 15",
  "author": "Your Name",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "typescript",
    "event-management",
    "saas",
    "prisma",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "npm run db:deploy && npm run db:seed",
    "db:studio": "prisma studio",
    "clean": "rimraf .next out",
    "i18n:check": "node scripts/validate-i18n.js",
    "import:events:csv": "tsx scripts/csv-to-events-json.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "health-check": "node scripts/health-check.js",
    "csp-check": "node scripts/csp-monitor.js",
    "env-check": "node scripts/validate-env.js",
    "validate": "npm run env-check && npm run health-check && npm run lint && npm test",
    "deploy-check": "npm run env-check && npm run build",
    "emergency-stable": "node scripts/emergency-stability.js",
    "restore-backup": "node scripts/restore-from-backup.js",
    "test-stability": "node scripts/test-stability.js",
    "prebuild": "npm run type-check && npm run lint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.1",
    "@prisma/client": "^6.16.2",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.4",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^6.1.0",
    "next": "15.5.3",
    "next-auth": "^4.24.11",
    "next-intl": "^4.3.9",
    "prisma": "^6.16.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@jest/globals": "^29.7.0",
    "@next/env": "^15.5.3",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "depcheck": "^1.4.7",
    "eslint": "^9",
    "eslint-config-next": "^15.5.3",
    "jest": "^30.1.3",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^30.1.2",
    "playwright": "^1.48.2",
    "playwright-core": "^1.48.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=18"
  }
}
